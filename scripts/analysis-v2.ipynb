    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "df = pd.read_csv(\"../artifacts/analysis/rm-loss/rm_loss_general.csv\")\n",
    "dfp = df.pivot_table(index=\"method\", columns=\"model\", values=\"metric\", aggfunc=\"sum\")\n",
    "dfp = dfp.reindex([\"identity\", \"actmat\", \"regmean\"])\n",
    "dfp.style.format(\"{:.2e}\")"
   ]
